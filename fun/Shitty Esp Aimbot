-- Keybind listener
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	
	-- Handle keybind remapping
	if waitingForKeybind then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			if waitingForKeybind == "esp" then
				espKeybind = input.KeyCode
				espKeybindButton.Text = input.KeyCode.Name
				espKeybindButton.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
			elseif waitingForKeybind == "lock" then
				lockKeybind = input.KeyCode
				lockKeybindButton.Text = input.KeyCode.Name
				lockKeybindButton.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
			elseif waitingForKeybind == "closeGui" then
				toggleGuiKeybind = input.KeyCode
				closeGuiKeybindButton.Text = input.KeyCode.Name
				closeGuiKeybindButton.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
			end
			waitingForKeybind = nil
		end
		return
	end
	
	if not scriptEnabled then return end
	
	-- Toggle GUI visibility
	if input.KeyCode == toggleGuiKeybind then
		togglesFrame.Visible = not togglesFrame.Visible
		return
	end
	
	-- ESP toggle
	if input.KeyCode == espKeybind then
		outlinesEnabled = not outlinesEnabled
		espCheckmark.Visible = outlinesEnabled
		
		if outlinesEnabled then
			addOutlinesToAllPlayers()
			espCheckbox.BackgroundColor3 = Color3.fromRGB(100, 60, 180)
		else
			removeAllOutlines()
			espCheckbox.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
		end
	end
	
	-- Lock toggle
	if input.KeyCode == lockKeybind and lockEnabled then
		if lockedPlayer then
			unlockCamera()
		else
			local nearestPlayer = getNearestPlayerToCrosshair()
			if nearestPlayer then
				lockOntoPlayer(nearestPlayer)
			end
		end
	end
end)

-- Function to create a highlight for a character
local function createHighlight(character)
	if highlights[character] then return end
	
	local highlight = Instance.new("Highlight")
	highlight.Adornee = character
	highlight.FillColor = Color3.fromRGB(0, 255, 0)
	highlight.OutlineColor = Color3.fromRGB(0, 200, 0)
	highlight.FillTransparency = 0.5
	highlight.OutlineTransparency = 0
	highlight.Parent = character
	
	highlights[character] = highlight
	
	-- Create name tag
	local head = character:FindFirstChild("Head")
	if head then
		local billboardGui = Instance.new("BillboardGui")
		billboardGui.Name = "ESPNameTag"
		billboardGui.Adornee = head
		billboardGui.Size = UDim2.new(0, 200, 0, 50)
		billboardGui.StudsOffset = Vector3.new(0, 2, 0)
		billboardGui.AlwaysOnTop = true
		billboardGui.Parent = head
		
		local nameLabel = Instance.new("TextLabel")
		nameLabel.Size = UDim2.new(1, 0, 1, 0)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Text = character.Name
		nameLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
		nameLabel.TextStrokeTransparency = 0.5
		nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		nameLabel.TextSize = 18
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.Parent = billboardGui
	end
end

-- Function to remove highlight from a character
local function removeHighlight(character)
	if highlights[character] then
		highlights[character]:Destroy()
		highlights[character] = nil
	end
	
	-- Remove name tag
	local head = character:FindFirstChild("Head")
	if head then
		local nameTag = head:FindFirstChild("ESPNameTag")
		if nameTag then
			nameTag:Destroy()
		end
	end
end

-- Function to add highlights to all players
function addOutlinesToAllPlayers()
	for _, plr in pairs(Players:GetPlayers()) do
		if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
			createHighlight(plr.Character)
		end
	end
end

-- Function to remove all highlights
function removeAllOutlines()
	for character, highlight in pairs(highlights) do
		highlight:Destroy()
		
		-- Remove name tag when clearing all
		local head = character:FindFirstChild("Head")
		if head then
			local nameTag = head:FindFirstChild("ESPNameTag")
			if nameTag then
				nameTag:Destroy()
			end
		end
	end
	highlights = {}
end

-- Function to get the nearest player to crosshair
function getNearestPlayerToCrosshair()
	local nearestPlayer = nil
	local shortestDistance = math.huge
	local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
	
	for _, plr in pairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
			local character = plr.Character
			local hrp = character.HumanoidRootPart
			
			local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
			
			if onScreen then
				local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
				local distance = (screenPos2D - screenCenter).Magnitude
				
				if distance < shortestDistance then
					shortestDistance = distance
					nearestPlayer = plr
				end
			end
		end
	end
	
	return nearestPlayer
end

-- Function to lock camera onto a player
function lockOntoPlayer(targetPlayer)
	if lockConnection then
		lockConnection:Disconnect()
		lockConnection = nil
	end
	
	lockedPlayer = targetPlayer
	
	if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
		lockConnection = RunService.RenderStepped:Connect(function()
			if lockedPlayer and lockedPlayer.Character and lockedPlayer.Character:FindFirstChild("HumanoidRootPart") then
				local targetPos = lockedPlayer.Character.HumanoidRootPart.Position
				camera.CFrame = CFrame.new(camera.CFrame.Position, targetPos)
			else
				unlockCamera()
			end
		end)
	end
end

-- Function to unlock camera
function unlockCamera()
	if lockConnection then
		lockConnection:Disconnect()
		lockConnection = nil
	end
	lockedPlayer = nil
end

-- Handle new players joining
local function onPlayerAdded(plr)
	plr.CharacterAdded:Connect(function(character)
		if outlinesEnabled then
			task.wait(0.1)
			createHighlight(character)
		end
	end)
end

-- Handle player leaving
local function onPlayerRemoving(plr)
	if plr.Character then
		removeHighlight(plr.Character)
	end
	
	if plr == lockedPlayer then
		unlockCamera()
	end
end

-- Connect player events
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- Setup existing players
for _, plr in pairs(Players:GetPlayers()) do
	onPlayerAdded(plr)
end
